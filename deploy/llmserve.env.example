# /etc/llmserve/llmserve.env -- systemd EnvironmentFile.
# Plain KEY=VALUE only: no shell quoting, no expansion, no inline comments.

LLMSERVE_BACKEND=vllm
LLMSERVE_MODEL=meta-llama/Llama-3.1-8B-Instruct

LLMSERVE_HOST=127.0.0.1
LLMSERVE_PORT=8000

# Admission control. Size these from a load sweep -- see docs/tuning.md.
LLMSERVE_MAX_CONCURRENT_REQUESTS=32
LLMSERVE_MAX_QUEUE_SIZE=48
LLMSERVE_QUEUE_TIMEOUT_S=10
LLMSERVE_REQUEST_TIMEOUT_S=300
LLMSERVE_MAX_TOKENS_CAP=2048

# Must be < TimeoutStopSec in the unit file.
LLMSERVE_DRAIN_TIMEOUT_S=120

LLMSERVE_LOG_LEVEL=INFO
LLMSERVE_LOG_JSON=true

# Comma-separated bearer tokens. Leave empty only behind a trusted network boundary.
LLMSERVE_API_KEYS=

LLMSERVE_VLLM_GPU_MEMORY_UTILIZATION=0.90
LLMSERVE_VLLM_TENSOR_PARALLEL_SIZE=1
LLMSERVE_VLLM_DTYPE=auto

# Needed for gated models on the Hugging Face hub.
HUGGING_FACE_HUB_TOKEN=
