# Backend: "mock" (no GPU required) or "vllm"
LLMSERVE_BACKEND=mock
LLMSERVE_MODEL=facebook/opt-125m

LLMSERVE_HOST=0.0.0.0
LLMSERVE_PORT=8000

# Admission control
LLMSERVE_MAX_CONCURRENT_REQUESTS=8
LLMSERVE_MAX_QUEUE_SIZE=64
LLMSERVE_QUEUE_TIMEOUT_S=15
LLMSERVE_REQUEST_TIMEOUT_S=600
LLMSERVE_MAX_TOKENS_CAP=2048
LLMSERVE_MAX_PROMPT_CHARS=64000
LLMSERVE_DRAIN_TIMEOUT_S=30

# Streaming
LLMSERVE_STREAM_KEEPALIVE_S=15

# Auth (comma separated; empty disables auth)
LLMSERVE_API_KEYS=

# Observability
LLMSERVE_LOG_LEVEL=INFO
LLMSERVE_LOG_JSON=true

# Mock backend shape
LLMSERVE_MOCK_TTFT_MS=120
LLMSERVE_MOCK_ITL_MS=18
LLMSERVE_MOCK_JITTER=0.25
LLMSERVE_MOCK_CONTENTION=0.06

# vLLM engine
LLMSERVE_VLLM_TENSOR_PARALLEL_SIZE=1
LLMSERVE_VLLM_GPU_MEMORY_UTILIZATION=0.90
LLMSERVE_VLLM_MAX_MODEL_LEN=
LLMSERVE_VLLM_DTYPE=auto
LLMSERVE_VLLM_ENFORCE_EAGER=false
LLMSERVE_VLLM_TRUST_REMOTE_CODE=false
